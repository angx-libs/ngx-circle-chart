{
  "name": "ngx-circle-chart-workspace",
  "version": "4.0.0",
  "description": "Demo workspace for @angx/ngx-circle-chart",
  "license": "MIT",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "npm run build:lib && ng serve",
    "build": "npm run build:lib && ng build ngx-circle-chart",
    "build:lib": "ng build @angx/ngx-circle-chart",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "pack:lib": "npm run build:lib && npm pack ./dist/angx/ngx-circle-chart",
    "publish:lib": "npm run build:lib && npm publish ./dist/angx/ngx-circle-chart --access public"
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "chart.js": "^4.5.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.1.0",
    "typescript": "~6.0.0",
    "vitest": "^4.0.8"
  }
}
